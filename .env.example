# ==============================================================================
# SmartBancs App - Variables de Entorno (docker compose lee este archivo como .env)
# ==============================================================================

# Google Gemini (opcional). Vacío por defecto: sin clave el ai-service usa el motor
# heurístico local (fallback). Con clave, si Gemini falla o se excede la cuota, también
# conmuta al fallback sin bloquear el flujo transaccional.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Base de Datos PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_NAME=smartbancs_db
# El esquema lo define backend/sql/schema.sql. Nunca "true": TypeORM borraría índices únicos y CHECKs.
DB_SYNCHRONIZE=false

# Límites transaccionales del backend
DB_LOCK_TIMEOUT_MS=2000        # espera máxima por un lock de fila (SQLSTATE 55P03 -> 503)
DB_STATEMENT_TIMEOUT_MS=5000   # duración máxima de una sentencia (SQLSTATE 57014 -> 503)
TX_MAX_ATTEMPTS=3              # intentos ante deadlock 40P01 / serialización 40001

# Relay del Transactional Outbox
OUTBOX_POLL_INTERVAL_MS=500    # frecuencia del relay
OUTBOX_BATCH_SIZE=100          # eventos por lote (se publican y confirman juntos)
OUTBOX_RELAY_ENABLED=true      # "false" desactiva el relay en esta instancia

# Mensajería RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_CONFIRM_TIMEOUT_MS=5000       # espera máxima del ack del broker (publisher confirms)
RABBITMQ_RECONNECT_MAX_DELAY_MS=30000  # tope del backoff de reconexión (reintenta sin límite)

# Endpoints /api/v1/simulation (pico de quincena y diagnóstico de BD). Solo para demo/staging.
SIMULATION_ENABLED=false

# URL del backend que usa el ai-service para guardar recomendaciones
BACKEND_API_URL=http://backend:4000
