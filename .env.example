# ==============================================================================
# SmartBancs App - Variables de Entorno
# ==============================================================================

# Google Gemini API Key (Opcional pero recomendado para activar IA Generativa en vivo)
# Si no se define o si se excede la cuota de Google, el sistema conmuta automáticamente
# al motor heurístico financiero local (Fallback Resiliente sin caídas).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Base de Datos PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_NAME=smartbancs_db

# Mensajería RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# URLs de Microservicios
BACKEND_API_URL=http://backend:4000
AI_SERVICE_URL=http://ai-service:8000
