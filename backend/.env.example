# Desarrollo local del backend (npm run start:dev). En docker compose se usan las variables de docker-compose.yml.
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# LOG_FORMAT=json   # por defecto: json si NODE_ENV=production, legible en otro caso

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_NAME=smartbancs_db
# El esquema lo define sql/schema.sql. Nunca "true": TypeORM borraría índices únicos y CHECKs.
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_POOL_MAX=25
DB_POOL_MIN=5

# Límites transaccionales
DB_LOCK_TIMEOUT_MS=2000        # espera máxima por un lock de fila (SQLSTATE 55P03 -> 503)
DB_STATEMENT_TIMEOUT_MS=5000   # duración máxima de una sentencia (SQLSTATE 57014 -> 503)
TX_MAX_ATTEMPTS=3              # intentos ante deadlock 40P01 / serialización 40001

# Relay del Transactional Outbox
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
OUTBOX_RELAY_ENABLED=true

# Message Broker (RabbitMQ)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_CONFIRM_TIMEOUT_MS=5000
RABBITMQ_RECONNECT_MAX_DELAY_MS=30000

# Endpoints /api/v1/simulation (mueven saldos reales): solo demo/staging
SIMULATION_ENABLED=true
