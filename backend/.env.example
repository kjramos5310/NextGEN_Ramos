PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=smartbancs_db
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_POOL_MAX=25
DB_POOL_MIN=5

# Message Broker (RabbitMQ)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# AI Service URL (Optional direct fallback)
AI_SERVICE_URL=http://localhost:8000
