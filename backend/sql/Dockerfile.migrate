# Imagen del job de migración (Cloud Run Job). Aplica los scripts DDL/DML una sola vez
# sobre Cloud SQL, conectándose por el socket del conector de Cloud SQL.
FROM postgres:16-alpine
COPY 00-observability.sql schema.sql seed.sql /sql/
COPY migrate.sh /usr/local/bin/migrate.sh
RUN chmod +x /usr/local/bin/migrate.sh
ENTRYPOINT ["/usr/local/bin/migrate.sh"]
